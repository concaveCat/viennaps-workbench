    "materialIdsByLevelSetIndex": {
      "items": {
        "type": "integer"
      },
      "title": "Materialidsbylevelsetindex",
      "type": "array"
    },
    "sameMaterialInternalInterfacesHidden": {
      "title": "Samematerialinternalinterfaceshidden",
      "type": "boolean"
    },
    "noOp": {
      "title": "Noop",
      "type": "boolean"
    },
    "measuredGeometry": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Measuredgeometry"
    },
    "surfaceBounds": {
      "items": {
        "type": "number"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Surfacebounds",
      "type": "array"
