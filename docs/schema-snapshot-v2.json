  "required": [
    "schemaVersion",
    "dimension",
    "topology",
    "runId",
    "stepId",
    "stepName",
    "stepIndex",
    "axisMap",
    "coordinateUnit",
    "points",
    "triangles",
    "cellData",
    "materials",
    "mesh",
    "gridDelta",
    "materialIdsByLevelSetIndex",
    "sameMaterialInternalInterfacesHidden",
    "noOp",
    "measuredGeometry",
    "surfaceBounds",
    "domainReadback"
  ],
  "title": "Snapshot3D",
  "type": "object"
}
