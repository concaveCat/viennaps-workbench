      "type": "array"
    },
    "triangles": {
      "items": {
        "items": {
          "type": "integer"
        },
        "maxItems": 3,
        "minItems": 3,
        "type": "array"
      },
      "title": "Triangles",
      "type": "array"
    },
    "cellData": {
      "$ref": "#/$defs/CellMaterials"
    },
    "materials": {
      "additionalProperties": {
        "$ref": "#/$defs/Material"
      },
      "title": "Materials",
      "type": "object"
    },
    "mesh": {
      "$ref": "#/$defs/Mesh3D"
    },
    "gridDelta": {
      "gt": 0,
      "title": "Griddelta",
      "type": "number"
