    "Axes": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "const": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "const": 1,
          "title": "Y",
          "type": "integer"
        },
        "z": {
          "const": 2,
          "title": "Z",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "Axes",
      "type": "object"
    },
    "CellMaterials": {
      "additionalProperties": false,
