          "type": "string"
        },
        "levelSetIndexes": {
          "items": {
            "type": "integer"
          },
          "title": "Levelsetindexes",
          "type": "array"
        },
        "sourceStepId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
