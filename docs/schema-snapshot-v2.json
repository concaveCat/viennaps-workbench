          "ge": 0,
          "title": "Pointcount",
          "type": "integer"
        },
        "triangleCount": {
          "ge": 0,
          "title": "Trianglecount",
          "type": "integer"
        },
        "topology": {
          "const": "triangles",
          "title": "Topology",
          "type": "string"
        }
      },
      "required": [
        "vtk",
        "pointCount",
        "triangleCount",
        "topology"
      ],
