      "type": "integer"
    },
    "topology": {
      "const": "triangles",
      "title": "Topology",
      "type": "string"
    },
    "runId": {
      "title": "Runid",
      "type": "string"
    },
    "stepId": {
      "title": "Stepid",
      "type": "string"
    },
    "stepName": {
      "title": "Stepname",
      "type": "string"
    },
    "stepIndex": {
      "title": "Stepindex",
      "type": "integer"
