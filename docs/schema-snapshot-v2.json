          "type": "array"
        }
      },
      "required": [
        "materialIds"
      ],
      "title": "CellMaterials",
      "type": "object"
    },
    "Material": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "Mask",
            "Si",
            "SiO2"
          ],
