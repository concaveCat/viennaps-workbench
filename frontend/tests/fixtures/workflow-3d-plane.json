{
  "schemaVersion": 7,
  "name": "3D plane etch fixture",
  "dimension": 3,
  "units": {"length": "um", "time": "s", "rate": "um/s", "angle": "deg"},
  "domain": {"gridDelta": 0.5, "xExtent": 4.0, "yExtent": 4.0, "boundaryXY": "reflective"},
  "geometry": {"kind": "plane", "height": 0.0, "substrateMaterial": "Si"},
  "steps": [
