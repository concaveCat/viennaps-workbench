  {
    "id": "wet",
    "label": "Wet Etching (Cantilever)",
    "meta": "2D · trench · wetEtch",
    "source": "examples/cantileverWetEtching",
    "note": "源码为 3D GDS 悬臂梁；这里用 2D trench + 晶向速率近似。",
    "sample": {
      "schemaVersion": 7,
      "name": "Wet Etching (Cantilever)",
      "dimension": 2,
      "units": {
        "length": "um",
        "time": "s",
        "rate": "um/s",
        "angle": "deg"
      },
      "domain": {
        "gridDelta": 0.2,
        "xExtent": 20,
        "xBoundary": "reflective"
      },
      "geometry": {
        "kind": "trench",
        "width": 8.0,
        "depth": 4.0,
        "taperAngle": 0,
        "maskHeight": 0.8,
        "maskTaperAngle": 0,
        "substrateMaterial": "Si",
        "maskMaterial": "Mask"
      },
      "steps": [
        {
          "id": "sample_01",
          "name": "晶向湿法刻蚀",
          "enabled": true,
          "operation": "etch",
          "model": "specialized",
          "nativeModel": "wetEtch",
          "nativeParameters": {
            "materialRates": {
              "Si": 0.0132833,
              "Mask": 0.0
            },
            "useCrystallineRates": true,
            "direction100": [
              1,
              0,
              0
            ],
            "direction010": [
              0,
              1,
              0
            ],
            "rate100": 0.0132833,
            "rate110": 0.02425,
            "rate111": 8.33e-05,
            "rate311": 0.023933
          },
          "duration": 600.0
        }
      ],
      "solver": {
        "timeStepRatio": 0.25,
        "raysPerPoint": 64,
        "cpuThreads": 2,
        "random": {
          "mode": "fixed",
          "seed": 7
        },
        "enginePreference": "cpu",
        "timeoutSeconds": 120
      },
      "view": {
        "panX": 0,
        "panH": 0,
        "zoom": 1,
        "showGrid": true
      }
    }
  },
