[
  {
    "id": "trench-deposition",
    "label": "Trench Deposition",
    "meta": "2D · trench · singleParticle",
    "source": "examples/trenchDeposition",
    "note": "参数来自 config.txt：rate=1、sticking=0.1、5 s。",
    "sample": {
      "schemaVersion": 7,
      "name": "Trench Deposition",
      "dimension": 2,
      "units": {
        "length": "um",
        "time": "s",
        "rate": "um/s",
        "angle": "deg"
      },
      "domain": {
        "gridDelta": 0.24,
        "xExtent": 10,
        "xBoundary": "reflective"
      },
      "geometry": {
        "kind": "trench",
        "width": 4.0,
        "depth": 8.0,
        "taperAngle": 0,
        "maskHeight": 0.0,
        "maskTaperAngle": 0,
        "substrateMaterial": "Si",
        "maskMaterial": "Mask"
      },
      "steps": [
        {
          "id": "sample_01",
          "name": "Trench deposition",
          "enabled": true,
          "operation": "deposit",
          "model": "singleParticle",
          "duration": 5.0,
          "rateMagnitude": 1.0,
          "rateMode": "uniform",
          "depositMaterial": "SiO2",
          "stickingProbability": 0.1,
          "sourceExponent": 1.0
        }
      ],
      "solver": {
        "timeStepRatio": 0.25,
        "raysPerPoint": 64,
        "cpuThreads": 2,
        "random": {
          "mode": "fixed",
          "seed": 7
        },
        "enginePreference": "cpu",
        "timeoutSeconds": 120
      },
      "view": {
        "panX": 0,
        "panH": 0,
        "zoom": 1,
        "showGrid": true
      }
    }
  },
  {
    "id": "sf6o2-hole",
    "label": "SF6/O2 Hole Etching",
    "meta": "3D · hole · sf6o2",
    "source": "examples/holeEtching",
    "note": "参数来自 config.txt；A_Si 与 quarter-hole 尚未表达。",
    "sample": {
      "schemaVersion": 7,
      "name": "SF6/O2 Hole Etching",
      "dimension": 3,
      "units": {
        "length": "um",
        "time": "s",
        "rate": "um/s",
        "angle": "deg"
      },
      "domain": {
        "gridDelta": 0.03,
        "xExtent": 1.0,
        "yExtent": 1.0,
        "boundaryXY": "reflective"
      },
      "geometry": {
        "kind": "hole",
        "radius": 0.175,
        "depth": 1.0,
        "taperAngle": 1.193,
        "maskHeight": 1.2,
        "maskTaperAngle": 0,
        "substrateMaterial": "Si",
        "maskMaterial": "Mask"
      },
      "steps": [
        {
          "id": "sample_01",
          "name": "SF6/O2 等离子体刻蚀",
          "enabled": true,
          "operation": "etch",
          "model": "specialized",
          "nativeModel": "sf6o2",
          "nativeParameters": {
            "ionFlux": 10.0,
            "etchantFlux": 4500.0,
            "oxygenFlux": 800.0,
            "meanIonEnergy": 100,
            "sigmaIonEnergy": 10,
            "ionExponent": 1000,
            "oxySputterYield": 2,
            "etchStopDepth": -10
          },
          "duration": 60.0
        }
      ],
      "solver": {
        "timeStepRatio": 0.25,
        "raysPerPoint": 64,
        "cpuThreads": 2,
        "random": {
          "mode": "fixed",
          "seed": 7
        },
        "enginePreference": "cpu",
        "timeoutSeconds": 120
      },
      "view3D": {
        "projection": "parallel",
        "camera": null,
        "displayMode": "surface",
        "visibleMaterialIds": [],
        "opacityByMaterial": {},
        "clip": {
          "enabled": false,
          "axis": "x",
          "position": 0,
          "keep": "positive"
        },
        "section": {
          "enabled": false,
          "axis": "y",
          "position": 0
        }
      }
    }
